---
import { SITE } from '../data/site.js';
---
<div class="contact-rows reveal d3">
  <div class="contact-row">
    <svg viewBox="0 0 16 16"><path d="M2 4h12v9H2zM2 4l6 5 6-5"/></svg>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </div>
  <div class="contact-row">
    <svg viewBox="0 0 16 16"><path d="M11 9.5c.5.5.5 1.5 0 2l-.5.5c-1.5 1.5-5.5-2-7-4S1.5 3.5 3 2l.5-.5c.5-.5 1.5-.5 2 0L7 3c.5.5.5 1 .2 1.5-.2.5-.7 1-.7 1.5 0 1 3.5 4.5 4.5 4.5.5 0 1-.5 1.5-.7.5-.3 1-.3 1.5.2l1 1z"/></svg>
    <span>WhatsApp <a href={`https://wa.me/${SITE.whatsapp.link}`}>{SITE.whatsapp.display}</a></span>
  </div>
  <div class="contact-row">
    <svg viewBox="0 0 16 16"><path d="M11 9.5c.5.5.5 1.5 0 2l-.5.5c-1.5 1.5-5.5-2-7-4S1.5 3.5 3 2l.5-.5c.5-.5 1.5-.5 2 0L7 3c.5.5.5 1 .2 1.5-.2.5-.7 1-.7 1.5 0 1 3.5 4.5 4.5 4.5.5 0 1-.5 1.5-.7.5-.3 1-.3 1.5.2l1 1z"/></svg>
    <span>Teléfono {SITE.phones.map((p, i) => (
      <>{i > 0 && ' · '}<a href={`tel:${p.e164}`}>{p.display}</a></>
    ))}<span class="contact-hours">{SITE.hours}</span></span>
  </div>
  <div class="contact-row">
    <svg viewBox="0 0 16 16"><circle cx="8" cy="7" r="2.5"/><path d="M8 1.5C5.5 1.5 3.5 3.4 3.5 5.8c0 3.5 4.5 8.7 4.5 8.7s4.5-5.2 4.5-8.7C12.5 3.4 10.5 1.5 8 1.5z"/></svg>
    <span>{SITE.city}, {SITE.country}</span>
  </div>
</div>
