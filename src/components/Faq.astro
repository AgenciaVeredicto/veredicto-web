---
import { faq } from '../data/site.js';

// Abierto por defecto (sin <details>): el contenido tiene que estar visible
// para que un rastreador de IA lo lea sin depender de interaccion.
---
<section id="preguntas">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-num reveal">Preguntas frecuentes</div>
      <h2 class="sec-title reveal d1">Lo que nos preguntan<br><em>antes de empezar.</em></h2>
      <p class="sec-intro reveal d2">Si la duda no está en la lista, la respondemos por WhatsApp o por correo. El diagnóstico es gratuito y no compromete a nada.</p>
    </div>

    <dl class="faq-list">
      {faq.map(item => (
        <div class="faq-item reveal">
          <dt>{item.q}</dt>
          <dd>{item.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
